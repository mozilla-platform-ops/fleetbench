#!/usr/bin/env python3
"""Build the collector for one or all fleet platforms.

Usage:
  ./build                       # build all four (linux + windows + mac + android)
  ./build --platform linux      # build linux only
  ./build --platform windows    # build windows only
  ./build --platform mac        # build mac only (host arch)
  ./build --platform android    # build android (aarch64); requires NDK

Builder per platform:
  linux, windows  -> cargo-zigbuild (zig as linker, no platform SDK required)
  mac             -> native cargo build (uses host Apple toolchain)
  android         -> cargo ndk (requires Android NDK + cargo-ndk)

Tooling:
  brew install zig
  cargo install cargo-zigbuild cargo-ndk
  rustup target add x86_64-unknown-linux-musl x86_64-pc-windows-gnu \\
                    aarch64-apple-darwin aarch64-linux-android
  # Android NDK: install via Android Studio's SDK Manager or `brew install --cask android-ndk`,
  # then export ANDROID_NDK_HOME pointing at it.
"""

from __future__ import annotations

import argparse
import os
import shlex
import shutil
import subprocess
import sys
from pathlib import Path
from typing import Optional

def _host_mac_target() -> str:
    """Pick the rustup triple matching the host Mac's architecture."""
    import platform as _platform
    machine = _platform.machine()
    if machine in ("arm64", "aarch64"):
        return "aarch64-apple-darwin"
    if machine in ("x86_64", "AMD64"):
        return "x86_64-apple-darwin"
    sys.exit(f"unsupported mac arch: {machine}")


TARGETS = {
    # platform -> (rust_target, binary_name, builder)
    "linux":   ("x86_64-unknown-linux-musl", "fleetbench",     "zigbuild"),
    "windows": ("x86_64-pc-windows-gnu",     "fleetbench.exe", "zigbuild"),
    "mac":     (_host_mac_target(),          "fleetbench",     "cargo"),
    "android": ("aarch64-linux-android",     "fleetbench",     "cargo-ndk"),
}


def preflight(platform: str) -> Optional[str]:
    """Return None if the platform is buildable, else a human message explaining what's missing."""
    if platform == "android":
        missing = []
        if shutil.which("cargo-ndk") is None:
            missing.append("cargo-ndk not on PATH (install: cargo install cargo-ndk)")
        ndk_home = os.environ.get("ANDROID_NDK_HOME")
        if not ndk_home:
            missing.append("ANDROID_NDK_HOME not set (install NDK and export it; see README)")
        elif not Path(ndk_home).is_dir():
            missing.append(f"ANDROID_NDK_HOME={ndk_home} does not exist")
        if missing:
            return "; ".join(missing)
    return None


def run_quiet(cmd: list[str]) -> None:
    """Run a command, suppressing output unless it fails."""
    cp = subprocess.run(cmd, capture_output=True, text=True)
    if cp.returncode != 0:
        print(f"$ {' '.join(shlex.quote(c) for c in cmd)}", file=sys.stderr)
        if cp.stdout:
            sys.stderr.write(cp.stdout)
        if cp.stderr:
            sys.stderr.write(cp.stderr)
        sys.exit(cp.returncode)


def build(platform: str) -> Path:
    rust_target, binary, builder = TARGETS[platform]
    if builder == "zigbuild":
        run_quiet(["cargo", "zigbuild", "--release", "--target", rust_target])
    elif builder == "cargo":
        run_quiet(["cargo", "build", "--release", "--target", rust_target])
    elif builder == "cargo-ndk":
        # cargo-ndk wraps cargo with the NDK toolchain configured. It needs
        # ANDROID_NDK_HOME set or the NDK on PATH. -t names the rust target.
        run_quiet([
            "cargo", "ndk", "-t", rust_target, "--", "build", "--release",
        ])
    else:
        sys.exit(f"unknown builder for {platform!r}: {builder}")
    out = Path(f"target/{rust_target}/release/{binary}")
    if not out.exists():
        sys.exit(f"build did not produce {out}")
    sz = out.stat().st_size
    print(f"  built: {out}  ({sz/1024/1024:.1f} MB)")
    return out


def main() -> int:
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument(
        "--platform",
        choices=["linux", "windows", "mac", "android", "all"],
        default="all",
        help="target platform (default: all)",
    )
    args = p.parse_args()

    platforms = list(TARGETS) if args.platform == "all" else [args.platform]
    skipped: list[str] = []
    for plat in platforms:
        print(f"\n=== {plat} ===")
        missing = preflight(plat)
        if missing:
            print(f"  skipped: {missing}")
            skipped.append(plat)
            continue
        build(plat)
    if skipped:
        print(f"\nskipped platforms: {', '.join(skipped)}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
