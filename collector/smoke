#!/usr/bin/env python3
"""End-to-end smoke: build a collector binary, scp to a host, run validation.

Usage:
  ./smoke <host>                              # Linux target (default)
  ./smoke <host> --platform windows
  ./smoke <host> --runs 5 --mode normal
  ./smoke <host> --no-build --no-scp

Requires locally:
  zig, cargo-zigbuild
  Linux:   x86_64-unknown-linux-musl rustup target
  Windows: x86_64-pc-windows-gnu rustup target

Requires on target: ssh with shell access; write access to home dir.
"""

from __future__ import annotations

import argparse
import json
import shlex
import statistics
import subprocess
import sys
from pathlib import Path

EXPECTED_PRIME_COUNTS = {
    10_000_000: 664_579,
    100_000_000: 5_761_455,
    1_000_000_000: 50_847_534,
}


class Target:
    """Per-platform build & invocation details."""
    def __init__(self, platform: str):
        if platform == "linux":
            self.rust_target = "x86_64-unknown-linux-musl"
            self.bin_local = Path(f"target/{self.rust_target}/release/fleetbench")
            self.bin_remote = "fleetbench"
            self.expect_linux_env = True
            self.expected_counter_kind = "linux_proc_stat"
            self.needs_chmod = True
        elif platform == "windows":
            self.rust_target = "x86_64-pc-windows-gnu"
            self.bin_local = Path(f"target/{self.rust_target}/release/fleetbench.exe")
            self.bin_remote = "fleetbench.exe"
            self.expect_linux_env = False
            self.expected_counter_kind = None  # null on Windows in the current MVP
            self.needs_chmod = False
        else:
            raise ValueError(f"unsupported platform: {platform}")
        self.platform = platform


def run(cmd: list[str], **kw) -> subprocess.CompletedProcess:
    print(f"$ {' '.join(shlex.quote(c) for c in cmd)}", file=sys.stderr)
    return subprocess.run(cmd, check=True, **kw)


def ssh_run(host: str, remote_cmd: str, capture: bool = False) -> str:
    cp = run(["ssh", host, remote_cmd], capture_output=capture, text=capture)
    return cp.stdout if capture else ""


def build(target: Target) -> None:
    run(["cargo", "zigbuild", "--release", "--target", target.rust_target])
    if not target.bin_local.exists():
        sys.exit(f"build did not produce {target.bin_local}")
    sz = target.bin_local.stat().st_size
    print(f"  built: {target.bin_local}  ({sz/1024/1024:.1f} MB)")


def scp_binary(host: str, target: Target) -> None:
    run(["scp", "-q", str(target.bin_local), f"{host}:{target.bin_remote}"])
    if target.needs_chmod:
        ssh_run(host, f"chmod +x {target.bin_remote}")


def remote_invoke(target: Target, subcmd: str) -> str:
    """Build the remote command for invoking the collector with a subcommand."""
    if target.platform == "windows":
        # Windows OpenSSH places the user in their home dir; the binary is
        # at ~/fleetbench.exe. .\ prefix is needed for cmd.exe; PowerShell
        # tolerates either. Use the unprefixed name and trust PATH if the
        # default shell is PowerShell; ./ otherwise. Default to the safer form.
        return f".\\{target.bin_remote} {subcmd}"
    return f"./{target.bin_remote} {subcmd}"


def validate_envelope(d: dict, target: Target) -> None:
    required_top = [
        "schema_version", "collector_version", "cpu_suite_version",
        "timestamp_utc", "status", "host", "cpu", "config", "environment", "results",
    ]
    missing = [k for k in required_top if k not in d]
    if missing:
        raise AssertionError(f"missing top-level keys: {missing}")
    assert d["schema_version"] == 3, f"schema_version={d['schema_version']}"
    assert d["cpu_suite_version"] == "cpu-v0"
    assert d["status"] == "ok", f"status={d['status']}"
    env = d["environment"]
    for slot in ("load_pre_warmup", "load_pre_timed", "load_post_timed"):
        s = env[slot]
        assert "cpu_counters" in s
        if target.expect_linux_env:
            cc = s["cpu_counters"]
            assert cc is not None, f"cpu_counters null in {slot}"
            assert cc["kind"] == target.expected_counter_kind, \
                f"counter kind in {slot}: {cc['kind']}"
            assert cc["total_units"] > cc["idle_units"], f"counters wrong in {slot}: {cc}"
            assert s["load_1"] is not None, f"load_1 null in {slot}"
        else:
            # On non-Linux the MVP emits null env fields. Schema must still
            # have the slots; the values just aren't populated yet.
            for field in ("cpu_counters", "load_1", "load_5", "load_15"):
                assert field in s, f"missing field {field} in {slot}"
    expected = EXPECTED_PRIME_COUNTS[d["config"]["prime_limit"]]
    for name in ("prime_sieve_1t", "prime_sieve_mt"):
        r = d["results"][name]
        assert len(r["iterations"]) == d["config"]["iterations"]
        counts = {it["prime_count"] for it in r["iterations"]}
        assert counts == {expected}, f"{name} prime_count: {counts} != {expected}"


def fetch_run(host: str, target: Target, mode: str) -> dict:
    out = ssh_run(host, remote_invoke(target, f"cpu --mode {mode} --json"), capture=True)
    return json.loads(out)


def check_host_activity(host: str, target: Target) -> None:
    """gwhc activity check. Linux-only; silent skip on Windows."""
    if target.platform != "linux":
        print("  skipping (Windows host; gwhc is Linux-only)")
        return
    cp = subprocess.run(
        ["ssh", host, "command -v gwhc >/dev/null && gwhc --json || echo __NOT_FOUND__"],
        capture_output=True, text=True,
    )
    out = cp.stdout.strip()
    if "__NOT_FOUND__" in out or not out:
        print("  gwhc not available on host (skipping activity check)")
        return
    try:
        data = json.loads(out)
    except json.JSONDecodeError:
        print(f"  gwhc returned non-JSON output:\n{out}")
        return
    state = data.get("state", "?")
    desc = data.get("state_description", "")
    print(f"  state: {state}  ({desc})")
    non_pass = [c for c in data.get("checks", []) if c.get("status") != "pass"]
    if non_pass:
        print(f"  {len(non_pass)} check(s) not passing:")
        for c in non_pass:
            print(f"    - {c.get('name')}: {c.get('status')} ({c.get('detail', '')})")
    for w in data.get("warnings", []):
        print(f"  warning: {w}")
    if state != "IDLE":
        print(f"\n  host is not idle (state={state}); skipping benchmark to avoid noisy results")
        sys.exit(0)


def stats(samples: list[float]) -> str:
    if not samples:
        return "(no samples)"
    mn, mx = min(samples), max(samples)
    med = statistics.median(samples)
    mean = statistics.mean(samples)
    return f"min={mn*1000:6.1f}ms  med={med*1000:6.1f}ms  mean={mean*1000:6.1f}ms  max={mx*1000:6.1f}ms  n={len(samples)}"


def summarize(label: str, runs: list[dict], workload: str) -> None:
    iter_0 = [r["results"][workload]["iterations"][0]["seconds"] for r in runs]
    iter_rest = [
        it["seconds"]
        for r in runs
        for it in r["results"][workload]["iterations"][1:]
    ]
    print(f"  {label} {workload} iter 0   {stats(iter_0)}")
    print(f"  {label} {workload} iter 1+  {stats(iter_rest)}")
    if iter_0 and iter_rest:
        ratio = statistics.median(iter_0) / statistics.median(iter_rest)
        print(f"  {label} {workload} iter0/rest median ratio: {ratio:.2f}x")


def main() -> int:
    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("host", help="ssh destination")
    p.add_argument("--platform", choices=["linux", "windows"], default="linux",
                   help="target platform (default: linux)")
    p.add_argument("--runs", type=int, default=1, help="number of benchmark runs (default 1)")
    p.add_argument("--mode", default="quick", choices=["quick", "normal", "long"],
                   help="cpu mode for the repeated runs (default quick)")
    p.add_argument("--no-build", action="store_true", help="skip cargo zigbuild")
    p.add_argument("--no-scp", action="store_true", help="skip scp (assume binary already on host)")
    args = p.parse_args()

    target = Target(args.platform)

    print(f"=== build ({target.rust_target}) ===")
    if args.no_build:
        print("  skipped")
    else:
        build(target)

    print(f"\n=== scp -> {args.host}:{target.bin_remote} ===")
    if args.no_scp:
        print("  skipped")
    else:
        scp_binary(args.host, target)

    print(f"\n=== host activity check on {args.host} ===")
    check_host_activity(args.host, target)

    print(f"\n=== inspect on {args.host} ===")
    print(ssh_run(args.host, remote_invoke(target, "inspect"), capture=True))

    print(f"=== cpu --mode {args.mode} x {args.runs} ===")
    runs: list[dict] = []
    for i in range(args.runs):
        d = fetch_run(args.host, target, args.mode)
        validate_envelope(d, target)
        st = [f"{x['seconds']*1000:.1f}" for x in d["results"]["prime_sieve_1t"]["iterations"]]
        mt = [f"{x['seconds']*1000:.1f}" for x in d["results"]["prime_sieve_mt"]["iterations"]]
        print(f"  run {i+1:>3}: 1t={st} ms  mt={mt} ms")
        runs.append(d)

    if args.runs > 1:
        print(f"\n=== aggregate over {args.runs} runs ({args.mode}) ===")
        summarize(args.mode, runs, "prime_sieve_1t")
        summarize(args.mode, runs, "prime_sieve_mt")

    print(f"\n=== negative test: bad args produce a well-formed failure envelope ===")
    cp = subprocess.run(
        ["ssh", args.host, remote_invoke(target, "cpu --threads 0 --json")],
        capture_output=True, text=True,
    )
    if cp.returncode != 1:
        sys.exit(f"expected exit 1 from --threads 0, got {cp.returncode}")
    err = json.loads(cp.stdout)
    assert err["status"] == "failed"
    assert err["error"]["kind"] == "invalid_arguments"
    print(f"  OK: deliberately-invalid --threads 0 emitted status=failed kind={err['error']['kind']} and exit=1")

    print("\n=== ALL SMOKE CHECKS PASSED ===")
    return 0


if __name__ == "__main__":
    sys.exit(main())
